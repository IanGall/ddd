# 本地开发环境变量模板
#
# 使用：cp .env.example .env.local，然后填写真实值。
# .env.local 已被 .gitignore 忽略，不会入库；启动脚本与 E2E 脚本会自动加载仓库根目录的 .env.local。
# 生产环境由部署平台注入同名环境变量，不依赖本文件。

# ------------------------------------------------------------------ MySQL
# 开发库（ddd_rbac / ian_dev_tech_db_00/01）与测试库（ddd_rbac_test / ian_test_tech_db_00/01）共用同一实例。
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ------------------------------------------------------------------ Redis
REDIS_PASSWORD=

# ------------------------------------------------------------------ Nacos（Dubbo 注册中心）
DUBBO_REGISTRY_PASSWORD=

# ------------------------------------------------------------------ 渠道 AES 主密钥
# Base64 编码的 32 字节随机值，可用 `openssl rand -base64 32` 生成。
# 生产环境必须使用独立的、非示例密钥。
CHANNEL_ENCRYPTION_MASTER_KEY=

# ------------------------------------------------------------------ 平台开户令牌
# 认证服务端（PLATFORM_ADMIN_TOKEN）与 E2E 脚本（COVERAGE_PLATFORM_TOKEN）必须一致。
PLATFORM_ADMIN_TOKEN=
COVERAGE_PLATFORM_TOKEN=

# ------------------------------------------------------------------ E2E 管理员账号（可选）
# 不填时由 E2E 脚本自动开户并缓存凭证（脚本用固定用户名 coverage_admin，缓存丢失后会因用户名已存在而开户失败）。
# 填了就必须是**平台开户接口创建**的**测试库**（ddd_rbac_test）账号：开户时会初始化 rbac:* 系统权限目录，
# AdminRbacE2eTest 依赖其中的 rbac:user:read。SQL 种子账号（test-admin@1.com，见
# ian-ddd-auth-boot/src/test/resources/sql/schema-rbac-mysql.sql）没有权限行，会以「未找到系统权限」失败；
# 开发库的 admin@1.com 在测试库里也不存在。开户命令见 ddd-base/ian-ddd-coverage/README.md。
# COVERAGE_E2E_LOGIN_NAME=
# COVERAGE_E2E_LOGIN_PASSWORD=
