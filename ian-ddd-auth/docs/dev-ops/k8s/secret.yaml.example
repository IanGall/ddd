# 认证服务的敏感配置「键名样例」——不是可直接使用的凭证，请勿 apply 本文件。
#
# 真实 Secret 用命令式创建（仓库是公开仓，任何真实口令一旦入库就无法靠删除撤除）：
#
#   # 方式一（推荐）：从仓库根 .env.local 提取这 6 个键，避免把 MYSQL_USERNAME / COVERAGE_* 一起带进 Secret
#   grep -E '^(MYSQL_PASSWORD|REDIS_PASSWORD|DUBBO_REGISTRY_PASSWORD|CHANNEL_ENCRYPTION_MASTER_KEY|PLATFORM_ADMIN_TOKEN)=' .env.local \
#     > /tmp/ian-ddd-auth.secret.env
#   echo "XXL_JOB_ACCESS_TOKEN=" >> /tmp/ian-ddd-auth.secret.env   # 未启用 XXL-Job 时留空即可
#   kubectl create secret generic ian-ddd-auth-secret -n <namespace> --from-env-file=/tmp/ian-ddd-auth.secret.env
#   rm -f /tmp/ian-ddd-auth.secret.env
#
#   # 方式二：直接 cp 本文件为 secret.yaml 填值后 apply（secret.yaml 已在 .gitignore 中兜底排除）
#
# 注意：不要把 .env.local 整份导入 Secret —— 其中的 MYSQL_USERNAME 会覆盖 ConfigMap 的同名键（Secret 在 envFrom 中靠后优先）。
apiVersion: v1
kind: Secret
metadata:
  name: ian-ddd-auth-secret
  labels:
    app.kubernetes.io/name: ian-ddd-auth
type: Opaque
stringData:
  # MySQL 口令（sharding-jdbc-prod.yaml 的 $${MYSQL_PASSWORD}）
  MYSQL_PASSWORD: REPLACE_ME
  # Redis 口令
  REDIS_PASSWORD: REPLACE_ME
  # Nacos（Dubbo 注册中心）口令
  DUBBO_REGISTRY_PASSWORD: REPLACE_ME
  # 渠道 AES 主密钥：Base64 编码的 32 字节随机值，可用 openssl rand -base64 32 生成
  CHANNEL_ENCRYPTION_MASTER_KEY: REPLACE_ME
  # 平台开户令牌：请求头 X-Platform-Token 的比对基准，必须与调用方一致
  PLATFORM_ADMIN_TOKEN: REPLACE_ME
  # XXL-Job 调度器凭证：XXL_JOB_ENABLED=false 时不需要解析，可留空
  XXL_JOB_ACCESS_TOKEN: ""
