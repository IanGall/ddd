<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iantech</groupId>
        <artifactId>ddd</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd-base</artifactId>
    <packaging>pom</packaging>

    <name>ddd-base</name>
    <description>DDD 工程共享模型、依赖版本与构建治理</description>

    <modules>
        <module>ddd-common</module>
        <module>ddd-context</module>
        <module>ddd-redis-starter</module>
        <module>ddd-id-generator-starter</module>
        <module>ddd-mysql-starter</module>
        <module>ddd-test-starter</module>
        <module>ddd-dependencies</module>
        <module>ddd-base-bom</module>
        <module>ian-ddd-coverage</module>
    </modules>

    <build>
        <plugins>
            <!-- 覆盖率采集与报告：仅 ddd-base 体系（含认证/网关与脚手架）继承，契约聚合不继承 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 覆盖率门槛仅在本工程显式启用，避免传递给下游工程与脚手架生成工程。 -->
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.60</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
