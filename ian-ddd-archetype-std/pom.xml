<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.iantech</groupId>
        <artifactId>ddd-base</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../ddd-base/pom.xml</relativePath>
    </parent>

    <artifactId>ian-frame-archetype-std</artifactId>
    <packaging>pom</packaging>

    <modules>
        <module>ian-frame-archetype-std-boot</module>
        <module>ian-frame-archetype-std-domain</module>
        <module>ian-frame-archetype-std-trigger</module>
        <module>ian-frame-archetype-std-infrastructure</module>
        <module>ian-frame-archetype-std-api</module>
    </modules>

    <properties>
        <ddd.base.version>1.0-SNAPSHOT</ddd.base.version>
        <maven.archetype.plugin.version>3.4.1</maven.archetype.plugin.version>
        <versions.maven.plugin.version>2.21.0</versions.maven.plugin.version>
    </properties>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ddd-base-bom</artifactId>
                <version>${ddd.base.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ian-frame-archetype-std-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ian-frame-archetype-std-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ian-frame-archetype-std-trigger</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.iantech</groupId>
                <artifactId>ian-frame-archetype-std-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-archetype-plugin</artifactId>
                    <version>${maven.archetype.plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions.maven.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok.mapstruct.binding.version}</version>
                        </path>
                        <path>
                            <groupId>io.github.linpeilie</groupId>
                            <artifactId>mapstruct-plus-processor</artifactId>
                            <version>${mapstruct-plus.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <profileActive>dev</profileActive>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <profileActive>test</profileActive>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profileActive>prod</profileActive>
            </properties>
        </profile>
        <!--
          覆盖率门槛：同 id 覆盖 ddd-base 的通用 60% 规则，按模块当前水平设防回退阈值。
          阈值取“当前覆盖率向下取整到 5%”，只挡回退、不阻塞正常演进。
          trigger / api 尚无测试，暂不设门槛；补上测试后再按同样方式加规则。
        -->
        <profile>
            <id>coverage-gate</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <includes>
                                                <include>cn.iantech:ian-frame-archetype-std-domain</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.35</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <includes>
                                                <include>cn.iantech:ian-frame-archetype-std-infrastructure</include>
                                            </includes>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>0.15</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
